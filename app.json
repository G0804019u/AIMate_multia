{
  "expo": {
    "name": "Multia",
    "slug": "multia",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "multia",
    "experiments": {
      "tsconfigPaths": true,
      "reactCompiler": true
    },
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-video"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
